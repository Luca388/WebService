{
  "info": {
    "name": "CRUD Backend Assignment",
    "description": "Spring Boot CRUD 과제 API 테스트 컬렉션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "GET 1 - 전체 상품 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "GET 2 - 상품 한 개 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/items/1"
      }
    },
    {
      "name": "POST 1 - 상품 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"모니터\",\n  \"price\": 250000\n}"
        },
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "POST 2 - 샘플 상품 생성",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/items/sample"
      }
    },
    {
      "name": "PUT 1 - 상품 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"게이밍 노트북\",\n  \"price\": 1800000\n}"
        },
        "url": "{{baseUrl}}/api/v1/items/1"
      }
    },
    {
      "name": "PUT 2 - 가격 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 35000\n}"
        },
        "url": "{{baseUrl}}/api/v1/items/2/price"
      }
    },
    {
      "name": "DELETE 1 - 상품 한 개 삭제",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/items/2"
      }
    },
    {
      "name": "DELETE 2 - 전체 상품 삭제",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "400 - 잘못된 생성 요청",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"price\": -1\n}"
        },
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "404 - 없는 상품 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/items/999"
      }
    },
    {
      "name": "500 - 서버 내부 오류",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/server-status/error"
      }
    },
    {
      "name": "503 - 서비스 사용 불가",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/server-status/unavailable"
      }
    },
    {
      "name": "v2 - Query Parameter 검색",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v2/items/search?keyword=마우스&page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "items",
            "search"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "마우스"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "v3 - Header 확인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-USER-ID",
            "value": "student01"
          },
          {
            "key": "Authorization",
            "value": "Bearer test-token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"키보드\",\n  \"price\": 80000\n}"
        },
        "url": "{{baseUrl}}/api/v3/items/with-header"
      }
    }
  ]
}
