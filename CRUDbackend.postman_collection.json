{
  "info": {
    "name": "CRUD Backend Assignment",
    "description": "Spring Boot CRUD 과제 API 테스트 컬렉션입니다. 기본 테스트는 ./gradlew bootRun으로 실행합니다. 실제 서비스 비활성화 503 테스트는 ./gradlew bootRun --args='--item.service.available=false'로 서버를 실행한 뒤 해당 요청을 사용합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "GET 1 - 전체 상품 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "GET 2 - 상품 한 개 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/items/1"
      }
    },
    {
      "name": "POST 1 - 상품 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"모니터\",\n  \"price\": 250000\n}"
        },
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "POST 2 - 샘플 상품 생성",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/items/sample"
      }
    },
    {
      "name": "PUT 1 - 상품 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"게이밍 노트북\",\n  \"price\": 1800000\n}"
        },
        "url": "{{baseUrl}}/api/v1/items/1"
      }
    },
    {
      "name": "PUT 2 - 가격 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 35000\n}"
        },
        "url": "{{baseUrl}}/api/v1/items/2/price"
      }
    },
    {
      "name": "DELETE 1 - 상품 한 개 삭제",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/items/2"
      }
    },
    {
      "name": "DELETE 2 - 전체 상품 삭제",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/items"
      }
    },
    {
      "name": "400 - 잘못된 생성 요청",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"price\": -1\n}"
        },
        "url": "{{baseUrl}}/api/v1/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 상태 코드가 400이다\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"응답이 status와 data를 포함한다\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(400);",
              "    pm.expect(body).to.have.property(\"data\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "404 - 없는 상품 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/items/999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 상태 코드가 404이다\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test(\"응답이 status와 data를 포함한다\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(404);",
              "    pm.expect(body).to.have.property(\"data\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "500 - 처리하지 못한 내부 예외",
      "request": {
        "method": "GET",
        "description": "Controller에서 IllegalStateException을 발생시키고 GlobalExceptionHandler가 500 응답으로 변환하는지 확인합니다.",
        "url": "{{baseUrl}}/api/v1/server-status/error"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 상태 코드가 500이다\", function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "pm.test(\"공통 오류 응답 형식이다\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(500);",
              "    pm.expect(body).to.have.property(\"data\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "503 - ServiceUnavailableException 처리",
      "request": {
        "method": "GET",
        "description": "Controller에서 ServiceUnavailableException을 발생시키고 GlobalExceptionHandler가 503 응답으로 변환하는지 확인합니다.",
        "url": "{{baseUrl}}/api/v1/server-status/unavailable"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 상태 코드가 503이다\", function () {",
              "    pm.response.to.have.status(503);",
              "});",
              "pm.test(\"공통 오류 응답 형식이다\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(503);",
              "    pm.expect(body).to.have.property(\"data\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "503 - 실제 상품 서비스 비활성화",
      "request": {
        "method": "GET",
        "description": "먼저 ./gradlew bootRun --args='--item.service.available=false' 명령으로 서버를 실행해야 합니다. 일반 상품 조회 과정에서 서비스 상태를 검사하고 실제 ServiceUnavailableException을 발생시킵니다.",
        "url": "{{baseUrl}}/api/v1/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"비활성화된 상품 서비스가 503을 반환한다\", function () {",
              "    pm.response.to.have.status(503);",
              "});",
              "pm.test(\"ServiceUnavailableException 메시지가 반환된다\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(503);",
              "    pm.expect(body.data).to.include(\"상품 서비스를 사용할 수 없습니다\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "v2 - Query Parameter 검색",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v2/items/search?keyword=마우스&page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v2",
            "items",
            "search"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "마우스"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "v3 - Header 확인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-USER-ID",
            "value": "student01"
          },
          {
            "key": "Authorization",
            "value": "Bearer test-token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"키보드\",\n  \"price\": 80000\n}"
        },
        "url": "{{baseUrl}}/api/v3/items/with-header"
      }
    }
  ]
}
